# Docker Compose API is on host port 8002 (not 8000).
# On a physical phone, localhost will not work - either:
#   1) Leave this as localhost:8002 and let the app rewrite to your Expo LAN IP, or
#   2) Set your Mac IP explicitly, e.g. http://192.168.1.10:8002/api
EXPO_PUBLIC_API_URL=http://localhost:8002/api
EXPO_PUBLIC_WEB_URL=http://localhost:5173
